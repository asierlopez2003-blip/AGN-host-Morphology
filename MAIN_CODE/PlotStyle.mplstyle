# ==========================================
# CONFIGURACIÓN GLOBAL DE FUENTES
# ==========================================
font.family         : STIXGeneral
mathtext.fontset    : stix

# ==========================================
# GROSOR DE LOS BORDES (SPINES)
# ==========================================
axes.linewidth      : 1.5

# ==========================================
# CONFIGURACIÓN DE LOS TICKS (MARCAS)
# ==========================================
# Eje X
xtick.direction     : in
xtick.top           : True
xtick.major.size    : 6
xtick.major.width   : 1.1
xtick.minor.visible : True
xtick.minor.size    : 3
xtick.minor.width   : 0.7

# Eje Y
ytick.direction     : in
ytick.right         : True
ytick.major.size    : 6
ytick.major.width   : 1.1
ytick.minor.visible : True
ytick.minor.size    : 3
ytick.minor.width   : 0.7
